{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{dist/**,manifest.json,providers/**}"
    }
  },
  "rewrites": [
    { "source": "/fetch", "destination": "/api/index" },
    { "source": "/parse", "destination": "/api/index" },
    { "source": "/image-proxy", "destination": "/api/index" },
    { "source": "/manifest.json", "destination": "/api/index" },
    { "source": "/dist/:match*", "destination": "/api/index" },
    { "source": "/status", "destination": "/api/index" },
    { "source": "/providers", "destination": "/api/index" }
  ]
}
